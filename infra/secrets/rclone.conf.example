# Copiar a infra/secrets/rclone.conf (ignorado por git), completar y proteger:
#   mkdir -p infra/secrets && chmod 700 infra/secrets
#   chmod 600 infra/secrets/rclone.conf
[r2]
type = s3
provider = Cloudflare
access_key_id = TU_ACCESS_KEY_ID
secret_access_key = TU_SECRET_ACCESS_KEY
endpoint = https://TU_ACCOUNT_ID.r2.cloudflarestorage.com
acl = private
no_check_bucket = true
